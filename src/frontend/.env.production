VITE_ENVIRONMENT="production"

# Vazio de proposito: a API e servida na mesma origem do site.
# Os ordered_cache_behavior do CloudFront (/identity/*, /main/*, /order/*,
# /invoice/*, /notificator/*) roteiam para o ALB interno, entao baseURL
# relativo resolve tudo same-origin e evita CORS.
#
# Nao coloque um dominio fixo aqui: o pipeline compila uma vez no CI e promove
# o MESMO artefato de staging para producao, entao a URL nao pode ser por ambiente.
VITE_APP_BASE_URL=""
